{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "observe-report-tools",
  "main": "deploy/worker.mjs",
  "account_id": "119fe0c7a4fcfbae6716ed0548b545c1",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "tools.observe.report", "custom_domain": true}],
  "assets": {
    "directory": ".site-dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {"enabled": false}
}
